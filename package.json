{
  "name": "llm-gateway",
  "version": "0.4.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:fast": "vitest run --exclude 'tests/e2e.test.ts' --exclude 'tests/compatibility.test.ts'",
    "test:watch": "vitest",
    "test:codex-poc": "CODEX_POC=1 vitest run tests/codex-go.poc.test.ts --reporter=verbose",
    "test:deepseek-poc": "DEEPSEEK_POC=1 vitest run tests/deepseek.poc.test.ts --reporter=verbose",
    "test:limits-poc": "LIMITS_POC=1 vitest run tests/limits.poc.test.ts --reporter=verbose",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
